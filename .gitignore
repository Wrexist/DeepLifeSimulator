# Windows device-name artifact (invalid as a real tracked path on Windows)
/nul

# Auto-generated weekly audit reports (reproducible via `npm run audit:weekly`;
# CI distributes them as build artifacts). The setup plan/playbook stays tracked.
tasks/weekly-audit-20*.md

# temp files
YOOO
Testf*light*command*
test_economy_fixes.js
test_onboarding_simulations.js
feedbackapple.txt
installcli.sh
# DeathPopup preview screenshots (generated by scripts/shoot-*.js)
scripts/death-popup-*.png

# Jest coverage output (54MB of generated HTML/lcov). Regenerated by
# `npm run test:coverage`; never belongs in the tree.
coverage/

# Screenshot capture output. Generated by scripts/capture-story-mode-shots.mjs
# against a running dev server — regenerable, and shipping it would add repo
# weight for images nothing references (preflight §11 already flags that class).
screenshots/story-mode/

# One-off diagnostic probes. Playwright and the ratchet scripts have to be run
# from the repo root to resolve node_modules (ESM ignores NODE_PATH), so a
# throwaway lands here rather than in a scratch directory. `.tmp.` keeps it
# obvious it is disposable and stops it being committed by reflex.
*.tmp.mjs
*.tmp.cjs
*.tmp.js
