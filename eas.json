{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ENABLE_ADMOB": "true",
        "EXPO_PUBLIC_ENABLE_IAP": "true",
        "EXPO_PUBLIC_ENABLE_ATT": "true"
      },
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "S3U8B8HH96",
        "ascAppId": "6749675615",
        "language": "en-US"
      }
    }
  }
}
