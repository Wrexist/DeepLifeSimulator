{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_ADMOB": "true",
        "EXPO_PUBLIC_ENABLE_IAP": "true",
        "EXPO_PUBLIC_ENABLE_ATT": "true",
        "EXPO_PUBLIC_USE_REVENUECAT": "true",
        "EXPO_PUBLIC_LIVEOPS_URL": "https://wrexist.github.io/DeepLifeSimulator/liveops.json",
        "EXPO_PUBLIC_BORING_BUILD": "false",
        "EXPO_PUBLIC_ENABLE_FIREBASE": "true"
      },
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease -x lintVitalRelease -x lintVitalAnalyzeRelease"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_DEVTOOLS": "true",
        "EXPO_PUBLIC_LIVEOPS_URL": "https://wrexist.github.io/DeepLifeSimulator/liveops.json",
        "EXPO_PUBLIC_BORING_BUILD": "true",
        "EXPO_PUBLIC_ENABLE_CLOUD_SAVE": "true",
        "EXPO_PUBLIC_CLOUD_SAVE_URL": "https://gyxmoqanjdvvllwjfsst.supabase.co/functions/v1"
      },
      "ios": {
        "simulator": false
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "S3U8B8HH96",
        "ascAppId": "6749675615",
        "language": "en-US"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
