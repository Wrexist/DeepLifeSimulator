{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_ADMOB": "true",
        "EXPO_PUBLIC_ENABLE_IAP": "true",
        "EXPO_PUBLIC_ENABLE_ATT": "true",
        "EXPO_PUBLIC_ENABLE_ANALYTICS": "true",
        "EXPO_PUBLIC_ANALYTICS_URL": "https://gyxmoqanjdvvllwjfsst.supabase.co/functions/v1/analytics"
      },
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "S3U8B8HH96",
        "ascAppId": "6749675615",
        "language": "en-US"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
